  <!-- To modify your build process, add your task inside one of the targets below and uncomment it. 
       Other similar extension points exist, see Microsoft.Common.targets.
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
  -->
  <PropertyGroup>
    <PostBuildEvent>if "$(ConfigurationName)" == "Release" (
  if NOT EXIST "$(TargetDir)ZZ_SOURCE_CODE_ZZ" (
    mkdir  "$(TargetDir)ZZ_SOURCE_CODE_ZZ"
    mkdir  "$(TargetDir)ZZ_SOURCE_CODE_ZZ\.github\"
    mkdir  "$(TargetDir)ZZ_SOURCE_CODE_ZZ\.github\workflows\"
    mkdir  "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\"
    mkdir  "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Properties\"
    mkdir  "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Books\"
    mkdir  "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Images\"
  )
  copy /Y "$(SolutionDir)*.sln" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\"
  copy /Y "$(SolutionDir)LICENSE.TXT" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\"
  copy /Y "$(SolutionDir)LICENSE.TXT" "$(TargetDir)license.txt"
  copy /Y "$(SolutionDir)README.md" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\"
  copy /Y "$(ProjectDir)*.csproj" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\"
  copy /Y "$(SolutionDir).gitignore" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\"
  copy /Y "$(SolutionDir).github\workflows\*.*"  "$(TargetDir)ZZ_SOURCE_CODE_ZZ\.github\workflows\"
  copy /Y "$(ProjectDir)*.cs" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\"
  copy /Y "$(ProjectDir)*.ico" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\"
  rem copy /Y "$(ProjectDir)*.jpg" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\"
  copy /Y "$(ProjectDir)*.resx" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\"
  copy /Y "$(ProjectDir)Readme*.*" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\"
  copy /Y "$(ProjectDir)Images\*.*" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Images\"
  copy /Y "$(ProjectDir)Books\*.xml" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Books\"
  copy /Y "$(ProjectDir)Properties\*.resx" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Properties\"
  copy /Y "$(ProjectDir)Properties\*.cs" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Properties\"
  copy /Y "$(ProjectDir)Properties\*.settings" "$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Properties\"
  cd /D "$(TargetDir)ZZ_SOURCE_CODE_ZZ"
  tar.exe -cf "..\source_code.tar" *.*
  cd ..
  tar.exe -a -c -f source_code.tar.zip source_code.tar
  del /Q source_code.tar
  cd /D "$(TargetDir)"
  del /F /S /Q ZZ_SOURCE_CODE_ZZ
  rmdir /S /Q ZZ_SOURCE_CODE_ZZ
  del /Q "*.pdb"
  tar.exe -a -c -f ..\$(ProjectName).zip *.*
)</PostBuildEvent>
  </PropertyGroup>
