  <data name="ExperimentalThanks" xml:space="preserve">
    <value>ಪ್ರಾಯೋಗಿಕ ಶಬ್ದಕೋಶದ ಪುಸ್ತಕವನ್ನು ಪ್ರಯತ್ನಿಸಿದ್ದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು. ದೋಷಗಳು ಅಥವಾ ಒಂದೇ ರೀತಿಯ ಧ್ವನಿಯಿರುವ ಅನುವಾದಗಳು ಕಂಡುಬಂದರೆ, ದಯವಿಟ್ಟು ನಿಮ್ಮ ಸುಧಾರಣಾ ಸಲಹೆಗಳನ್ನು ವೇದಿಕೆಯಲ್ಲಿ (ಫೋರಂನಲ್ಲಿ) ಪೋಸ್ಟ್ ಮಾಡಿ. ಸಾಫ್ಟ್‌ವೇರ್‌ನ ಆವೃತ್ತಿ, ಭಾಷೆಗಳ ಹೆಸರುಗಳು, ಪದಗಳ ಜೋಡಿಗಳು ಮತ್ತು ಸುಧಾರಣೆಗಳನ್ನು ನಮೂದಿಸಿ. ಸಾಧ್ಯವಾದರೆ, ಎಲ್ಲಾ ಸುಧಾರಣಾ ಸಲಹೆಗಳನ್ನು ಒಟ್ಟುಗೂಡಿಸಿ ಒಂದೇ ಬಾರಿಗೆ ಪೋಸ್ಟ್ ಮಾಡಿ.</value>
  </data>
  <data name="ExperimentalVocabularyBook" xml:space="preserve">
    <value>ಈ ಭಾಷಾ ಜೋಡಿಗಾಗಿ ಒಂದು ಪ್ರಾಯೋಗಿಕ ಶಬ್ದಕೋಶದ ಪುಸ್ತಕವಿದೆ; ಇದು ಸಾಫ್ಟ್‌ವೇರ್‌ನಂತೆಯೇ ಅದೇ ಪರವಾನಗಿಯ ಅಡಿಯಲ್ಲಿದೆ. ಇದನ್ನು ವಯಸ್ಕರಿಗಾಗಿ ನಿರಂತರ ಕೋರ್ಸ್‌ನಂತೆ ವಿನ್ಯಾಸಗೊಳಿಸಲಾಗಿದೆ, ಆದಾಗ್ಯೂ ಇದನ್ನು ಸ್ಥಳೀಯ ಭಾಷಿಕರು ಪರಿಶೀಲಿಸಿಲ್ಲ (ಪ್ರೂಫ್‌ರೀಡ್ ಮಾಡಿಲ್ಲ). ನೀವು ಇದನ್ನು ಪ್ರಯತ್ನಿಸಲು ಬಯಸುವಿರಾ?</value>
  </data>
